{
  "name": "esquizo-launcher",
  "productName": "EsquizoLauncher",
  "version": "1.0.4",
  "description": "Cliente exclusivo para los eventos de Minecraft de EsquizoStudios",
  "author": "EsquizoStudios",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.esquizostudios.launcher",
    "productName": "EsquizoLauncher",
    "copyright": "Copyright (C) 2026 EsquizoStudios. Todos los derechos reservados.",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EsquizoLauncher",
      "artifactName": "EsquizoLauncher-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "axios": "^1.20.0",
    "discord-rpc": "^4.0.1",
    "minecraft-launcher-core": "^3.11.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^25.1.8"
  }
}
